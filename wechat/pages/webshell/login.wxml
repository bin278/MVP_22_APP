<view class="container">
  <view class="content">
    <image class="logo" src="/images/logo.png" mode="aspectFit" />
    <view class="title">{{loading ? '登录中...' : '微信登录'}}</view>

    <view class="loading" wx:if="{{loading}}">
      <view class="spinner"></view>
      <text class="loading-text">正在验证身份...</text>
    </view>

    <button class="retry-btn" wx:if="{{!loading}}" bindtap="onRetry">
      重新登录
    </button>
  </view>
</view>
