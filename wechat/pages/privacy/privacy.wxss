.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 40rpx;
}

.content {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
  padding-bottom: 40rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.update-time {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.section {
  margin-bottom: 48rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.section-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.footer {
  margin-top: 60rpx;
  padding-top: 40rpx;
  border-top: 2rpx solid #f0f0f0;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}
