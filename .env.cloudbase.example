# ==========================================
# 国内版环境变量配置 (腾讯云 CloudBase)
# ==========================================

# 数据库提供商配置 (必填)
# 设置为 'cloudbase' 启用国内版
DATABASE_PROVIDER=cloudbase

# 腾讯云 CloudBase 配置 (必填)
# 从 https://console.cloud.tencent.com/tcb 获取
TENCENT_CLOUD_ENV_ID=your-env-id
TENCENT_CLOUD_SECRET_ID=your-secret-id
TENCENT_CLOUD_SECRET_KEY=your-secret-key

# DeepSeek AI 配置 (必填)
# 从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_TEMPERATURE=0.7

# JWT 配置 (必填)
# 用于用户认证
JWT_SECRET=your-random-jwt-secret-min-32-chars

# GitHub OAuth 配置 (可选)
# 用于GitHub集成功能
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# 微信登录配置 (国内版)
# ==========================================

# 微信公众号/开放平台配置
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
NEXT_PUBLIC_WECHAT_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/wechat/callback

# ==========================================
# 支付配置 (国内版)
# ==========================================

# 支付宝配置
ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=your-alipay-private-key
ALIPAY_PUBLIC_KEY=your-alipay-public-key

# 微信支付配置
WECHAT_PAY_MCH_ID=your-wechat-mch-id
WECHAT_PAY_API_KEY=your-wechat-api-key
WECHAT_PAY_CERT_PATH=path/to/apiclient_cert.pem
WECHAT_PAY_KEY_PATH=path/to/apiclient_key.pem

# ==========================================
# 说明
# ==========================================
#
# 1. 腾讯云 CloudBase 设置步骤:
#    - 访问 https://console.cloud.tencent.com/tcb 创建环境
#    - 在环境设置中获取 Env ID、Secret ID 和 Secret Key
#    - 在数据库中创建以下集合:
#      * users (用户)
#      * conversations (对话)
#      * conversation_files (对话文件)
#      * user_subscriptions (用户订阅)
#      * payments (支付记录)
#
# 2. 复制此文件为 .env.local 并填写实际值
# 3. 运行 npm run dev 启动开发服务器
# 4. 访问 http://localhost:3000 测试应用
#
# 注意:
# - 国内版使用腾讯云 CloudBase 和微信/支付宝支付
# - 国际版使用 Supabase 和 Stripe/PayPal
# - 通过 DATABASE_PROVIDER 环境变量切换版本
